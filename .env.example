DATABASE_URL=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
GEMINI_API_KEY=
JWT_SECRET=
EMBEDDING_MODEL=gemini-embedding-2
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=45000
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_DIM=768
CLIENT_ORIGIN=http://localhost:5173
PORT=3000
MAX_UPLOAD_MB=20
TRASH_RETENTION_DAYS=30
LIFECYCLE_DRY_RUN_DAYS=7
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.5
VERSION_SUGGEST_JACCARD=0.5
NEAR_DUP_UNIT_SIM=0.9
NEAR_DUP_DOC_FRAC=0.7
MAX_CONTEXT_CHARS=120000
DISABLE_JOBS=false
SKIP_AI_TESTS=false
# Postgres-backed ingestion worker; embedded keeps the single-process dev/deploy flow.
WORKER_MODE=embedded
WORKER_POLL_MS=1500
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=60
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Direct browser-to-object-storage uploads; multipart API uploads remain the fallback.
DIRECT_UPLOAD=true
UPLOAD_URL_TTL_SECONDS=600
# Cost/tiering estimates are simulations; the object store is not moved between real tiers.
STORAGE_HOT_USD_PER_GB_MONTH=0.023
STORAGE_COLD_USD_PER_GB_MONTH=0.004
COLD_AFTER_DAYS=30
# Minimum distinct active students required before topic aggregates are shown.
ANALYTICS_MIN_USERS=3
