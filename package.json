{
  "name": "gurukul-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "clean:ports": "npx --yes kill-port 3000 5173",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "build": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "start": "node server/dist/index.js",
    "worker": "tsx server/src/worker.ts",
    "start:worker": "node server/dist/worker.js",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "seed": "tsx server/src/db/seed.ts",
    "check:env": "tsx server/src/check-env.ts",
    "setup:cors": "tsx server/scripts/setup-bucket-cors.ts",
    "gc": "tsx server/src/jobs/gc.ts",
    "reconcile": "tsx server/src/jobs/reconcile.ts",
    "lifecycle": "tsx server/src/jobs/lifecycle.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@xyflow/react": "^12.8.5",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "^5.4.149",
    "pg": "^8.16.3",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.1"
  }
}
